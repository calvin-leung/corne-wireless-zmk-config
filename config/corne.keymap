#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 40 6 7 8 9 10 11 19 20 21 22 23 31 32 33 34 35 18 19 20 30 31 32 40 41>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp MINUS  &kp Q            &kp W            &kp F         &kp P              &kp B        &kp J      &kp L               &kp U         &kp Y             &kp SEMICOLON     &kp LBKT
&kp EQUAL  &hml LEFT_GUI A  &hml LEFT_ALT R  &hml LCTRL S  &hml LEFT_SHIFT T  &kp G        &kp M      &hmr RIGHT_SHIFT N  &hmr RCTRL E  &hmr RIGHT_ALT I  &hmr RIGHT_GUI O  &kp SQT
&kp BSLH   &kp Z            &kp X            &kp C         &kp D              &kp V        &kp K      &kp H               &kp COMMA     &kp DOT           &kp FSLH          &kp RBKT
                                             &lt 2 ESC     &lt 1 SPACE        &lt 6 TAB    &lt 4 RET  &lt 3 BACKSPACE     &lt 5 DELETE
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp LC(Z)   &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(LS(Z))    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LC(A)   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &kp INSERT  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
                            &trans     &trans     &trans    &kp ENTER   &kp BSPC        &kp DELETE
            >;
        };

        mouse {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp LC(Z)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(LS(Z))    &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LC(A)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                            &trans     &trans     &trans    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;
        };

        num {
            bindings = <
&kp SQT    &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &trans
&kp COMMA  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp FSLH   &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &trans
                              &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };

        sym {
            bindings = <
&kp LESS_THAN     &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK             &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &trans  &trans     &trans     &trans    &trans    &trans
&kp MINUS         &kp COLON       &kp DOLLAR     &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp GREATER_THAN  &kp TILDE       &kp EXCL       &kp AT                &kp POUND              &kp PIPE           &trans  &trans     &trans     &trans    &trans    &trans
                                                 &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &trans  &trans     &trans
            >;
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8             &kp F9     &trans     &bt BT_SEL 0  &trans     &trans     &trans    &trans    &trans
&trans  &kp F11  &kp F4  &kp F5             &kp F6     &trans     &bt BT_SEL 1  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp F10  &kp F1  &kp F2             &kp F3     &trans     &bt BT_SEL 2  &trans     &trans     &trans    &trans    &trans
                         &kp K_APPLICATION  &kp SPACE  &kp TAB    &trans        &trans     &trans
            >;
        };

        misc {
            bindings = <
&trans  &kp F13  &kp F14  &kp F15  &kp F16  &trans    &trans   &kp F16  &kp F15  &kp F14  &kp F13  &trans
&trans  &kp F17  &kp F18  &kp F19  &kp F20  &trans    &trans   &kp F20  &kp F19  &kp F18  &kp F17  &trans
&trans  &kp F21  &kp F22  &kp F23  &kp F24  &trans    &trans   &kp F24  &kp F23  &kp F22  &kp F21  &trans
                          &trans   &trans   &trans    &kp F18  &kp F19  &kp F20
            >;
        };
    };
};
