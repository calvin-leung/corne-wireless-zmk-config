#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp MINUS  &kp Q           &kp W           &kp E        &kp R             &kp T        &kp Y      &kp U              &kp I         &kp O            &kp P               &kp LBKT
&kp EQUAL  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G        &kp H      &mt RIGHT_SHIFT J  &mt RCTRL K   &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &kp SQT
&kp BSLH   &kp Z           &kp X           &kp C        &kp V             &kp B        &kp N      &kp M              &kp COMMA     &kp DOT          &kp FSLH            &kp RBKT
                                           &kp ESCAPE   &lt 1 SPACE       &lt 2 TAB    &lt 4 RET  &lt 3 BACKSPACE    &lt 5 DELETE
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &kp INSERT  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans
                            &trans     &trans     &trans    &kp ENTER   &kp BSPC        &kp DELETE
            >;
        };

        mouse {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO       &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &trans      &trans          &trans          &trans        &trans           &trans
                            &trans     &trans     &trans    &mkp RCLK   &mkp LCLK       &mkp MCLK
            >;
        };

        num {
            bindings = <
&kp SQT    &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &trans
&kp COMMA  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp FSLH   &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &trans
                              &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };

        sym {
            bindings = <
&kp LESS_THAN     &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTRK             &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &trans  &trans     &trans     &trans    &trans    &trans
&kp MINUS         &kp COLON       &kp DOLLAR     &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&kp GREATER_THAN  &kp TILDE       &kp EXCL       &kp AT                &kp POUND              &kp PIPE           &trans  &trans     &trans     &trans    &trans    &trans
                                                 &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &trans  &trans     &trans
            >;
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8             &kp F9     &kp PRINTSCREEN    &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp F11  &kp F4  &kp F5             &kp F6     &kp SCROLLLOCK     &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp F10  &kp F1  &kp F2             &kp F3     &kp PAUSE_BREAK    &trans  &trans     &trans     &trans    &trans    &trans
                         &kp K_APPLICATION  &kp SPACE  &kp TAB            &trans  &trans     &trans
            >;
        };
    };
};
